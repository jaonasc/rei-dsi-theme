rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per IP. The document ID is the visitor's public IP, so a
    // second click from the same IP tries to update an existing doc, which the
    // rules reject (counts as "already counted").
    match /download_ips/{ip} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ts'])
                    && request.resource.data.ts == request.time
                    && ip.matches('^[0-9a-zA-Z:.]+$');
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}